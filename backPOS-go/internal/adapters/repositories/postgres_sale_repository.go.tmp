func (r *PostgresSaleRepository) GetSalesBreakdownByRange(from, to string) (map[string]float64, error) {
	results := make(map[string]float64)
	
	// 1. EFECTIVO: Ventas (Cash - Change)
	var totalCash float64
	qCash := r.db.Model(&models.Sale{}).Where("status IN ('PAID', 'CREDIT') AND deleted_at IS NULL")
	if from != "" { qCash = qCash.Where("\"saleDate\" >= ?", from) }
	if to != "" { qCash = qCash.Where("\"saleDate\" <= ?", to) }
	qCash.Select("COALESCE(SUM(\"cashAmount\" - \"change\"), 0)").Scan(&totalCash)
	results["EFECTIVO"] = totalCash

	// 2. FIADOS: Monto de deuda emitido
	var totalFiados float64
	qFiados := r.db.Model(&models.Sale{}).Where("status = ? AND deleted_at IS NULL", "CREDIT")
	if from != "" { qFiados = qFiados.Where("\"saleDate\" >= ?", from) }
	if to != "" { qFiados = qFiados.Where("\"saleDate\" <= ?", to) }
	qFiados.Select("COALESCE(SUM(\"creditAmount\"), 0)").Scan(&totalFiados)
	results["FIADO"] = totalFiados

	// 3. TRANSFERENCIAS DIRECTAS (desde Ventas)
	rowsDirect, err := r.db.Model(&models.Sale{}).
		Select("\"transferSource\", SUM(\"transferAmount\") as total").
		Where("status IN ('PAID', 'CREDIT') AND \"transferAmount\" > 0 AND deleted_at IS NULL").
		Where("\"saleDate\" >= ? AND \"saleDate\" <= ?", from, to).
		Group("\"transferSource\"").Rows()
	
	totalTransferSum := 0.0
	if err == nil {
		defer rowsDirect.Close()
		for rowsDirect.Next() {
			var source string
			var total float64
			if err := rowsDirect.Scan(&source, &total); err == nil {
				if source == "" { source = "NEQUI" }
				source = strings.ToUpper(source)
				results[source] += total
				totalTransferSum += total
			}
		}
	}

	// 4. ABONOS (Recaudos de deuda)
	// Abonos Cash
	var totalAbonosCash float64
	r.db.Table("credit_payments").
		Where("\"createdAt\" >= ? AND \"createdAt\" <= ? AND \"amountCash\" > 0", from, to).
		Select("COALESCE(SUM(\"amountCash\"), 0)").Scan(&totalAbonosCash)
	results["EFECTIVO"] += totalAbonosCash

	// Abonos Transfer
	rowsAbonos, err := r.db.Table("credit_payments").
		Select("\"transferSource\", SUM(\"amountTransfer\") as total").
		Where("\"createdAt\" >= ? AND \"createdAt\" <= ? AND \"amountTransfer\" > 0", from, to).
		Group("\"transferSource\"").Rows()
	
	if err == nil {
		defer rowsAbonos.Close()
		for rowsAbonos.Next() {
			var source string
			var total float64
			if err := rowsAbonos.Scan(&source, &total); err == nil {
				if source == "" { source = "NEQUI" }
				source = strings.ToUpper(source)
				results[source] += total
				totalTransferSum += total
			}
		}
	}
	
	results["TRANSFERENCIA"] = totalTransferSum

	return results, nil
}
