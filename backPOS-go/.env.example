# ============================================================================
# .env.example â€” POS Surtifamiliar (backend)
# ----------------------------------------------------------------------------
# Copiar como .env antes de levantar la pila:
#     cp .env.example .env
# Nunca commitear el .env real. Todas las variables aqui son FICTICIAS: no
# usar ninguna sin reemplazarla.
#
# Grupos:
#   1. Base de datos (DB_*)
#   2. Contenedor PostgreSQL (POSTGRES_*)
#   3. API HTTP (PORT, SERVER_IP, FRONTEND_URL)
#   4. Seguridad (SECRET_KEY)
#   5. Logging
#   6. Pool de conexiones (opcional)
#   7. Telegram
#   8. SMTP (recuperacion de contrasena)
#   9. IA Anthropic
#  10. QR Bold / Bre-B (BOLD_*)
#  11. Respaldo pg_dump
#  12. Despliegue Docker (opcional)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Base de datos (consumida por el backend y por `migrate`)
# ----------------------------------------------------------------------------
# DB_HOST se sobrescribe automaticamente a "db" dentro del compose. Fuera
# del compose, apuntar al host real (ej. 127.0.0.1 o la IP del PostgreSQL
# existente en produccion).
DB_HOST=db
DB_PORT=5432
DB_USER=pos
DB_PASSWORD=cambia-esta-clave
DB_NAME=sistemapos

# ----------------------------------------------------------------------------
# 2. Contenedor PostgreSQL (consumida solo por el servicio `db`)
# ----------------------------------------------------------------------------
# DEBEN coincidir con DB_USER / DB_PASSWORD / DB_NAME para que el backend
# pueda autenticar contra la BD recien inicializada.
POSTGRES_USER=pos
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=sistemapos

# ----------------------------------------------------------------------------
# 3. API HTTP
# ----------------------------------------------------------------------------
PORT=3000
# Solo decorativo (aparece en el log de arranque y en la pantalla de setup).
SERVER_IP=127.0.0.1
# URL base del frontend (usada en los links de recuperacion de contrasena).
FRONTEND_URL=http://localhost

# ----------------------------------------------------------------------------
# 4. Seguridad
# ----------------------------------------------------------------------------
# Minimo 32 bytes aleatorios. Generar con `openssl rand -hex 32`.
SECRET_KEY=reemplazar-por-cadena-aleatoria-de-al-menos-64-hex

# ----------------------------------------------------------------------------
# 5. Logging
# ----------------------------------------------------------------------------
# Niveles aceptados: debug | info | warn | error | silent.
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 6. Pool de conexiones a PostgreSQL (opcional, defaults razonables)
# ----------------------------------------------------------------------------
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME_MINUTES=30
# DB_CONN_MAX_IDLE_MINUTES=5
# DB_PING_TIMEOUT_SECONDS=5

# ----------------------------------------------------------------------------
# 7. Telegram (alertas, respaldo nocturno, bot conversacional)
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chat ID autorizado para interactuar con el bot (si esta vacio, el bot
# ignora todos los mensajes entrantes).
AUTHORIZED_CHAT_ID=

# ----------------------------------------------------------------------------
# 8. SMTP (recuperacion de contrasena / notificaciones)
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=POS Surtifamiliar

# ----------------------------------------------------------------------------
# 9. IA Anthropic (OCR de facturas y bot conversacional)
# ----------------------------------------------------------------------------
# Si ANTHROPIC_API_KEY esta vacio, el OCR y el bot responden con errores
# controlados pero no rompen el arranque del API.
ANTHROPIC_API_KEY=

# Overrides opcionales del enrutamiento de modelos (defaults en ai_models.go).
# POS_AI_MODEL_FAST=claude-haiku-5-5
# POS_AI_MODEL_BALANCED=claude-sonnet-5-5
# POS_AI_MODEL_POWERFUL=claude-opus-5-5
# POS_AI_MODEL_CHAT=
# POS_AI_MODEL_REASONING=
# POS_AI_MODEL_VISION=

# ----------------------------------------------------------------------------
# 10. QR Bold / Bre-B
# ----------------------------------------------------------------------------
# Para el QR estatico gratuito con puente Android por LAN solo es
# obligatorio BOLD_BRIDGE_TOKEN. Los demas son para la pasarela oficial,
# aun no contratada. Si estan vacios, los endpoints oficiales fallan
# cerrado (401) y el bridge sigue funcionando.
BOLD_BRIDGE_TOKEN=
BOLD_SECRET_KEY=
BOLD_SIGNATURE_HEADER=X-Bold-Signature
BOLD_EVENT_SALE_APPROVED=SALE_APPROVED
# Allowlist de remitentes SMS Bold (coma-separada). Vacio -> canal SMS
# rechazado por seguridad.
BOLD_SMS_SENDERS=

# ----------------------------------------------------------------------------
# 11. Respaldo pg_dump
# ----------------------------------------------------------------------------
# En la imagen Docker pg_dump 16 ya esta instalado en /usr/bin/pg_dump,
# que esta en PATH. Dejar vacio para que el fallback de ResolvePgDumpPath
# lo encuentre via exec.LookPath. Solo setear si se usa un pg_dump a medida.
PG_DUMP_PATH=

# ----------------------------------------------------------------------------
# 12. Despliegue Docker (opcional)
# ----------------------------------------------------------------------------
# Ruta al contexto del frontend (repo hermano por defecto).
# FRONTEND_CONTEXT=../pos-frontend
# Puerto HTTP publicado por el frontend al host.
# HTTP_PORT=80  

# ----------------------------------------------------------------------------
# 13. Bridge Relay (balanza, impresion y cajon desde celulares/otros PC)
# ----------------------------------------------------------------------------
# Lista de tokens por caja que autentican a los agentes del scale-bridge
# cuando se conectan como clientes SALIENTES a /api/bridge/agent. Formato:
#
#     POS_AGENT_TOKENS=CAJA-01:tokenCaja1,CAJA-02:tokenCaja2
#
# Cada caja debe presentar su token en el header X-Bridge-Token al
# conectar; se compara en tiempo constante y nunca se loguea. Si la
# variable queda vacia, el endpoint /api/bridge/agent responde 503 y
# los navegadores no podran usar el relay; el resto del servidor
# funciona igual.
#
# Generar tokens con 'openssl rand -hex 32' (uno por caja). Mantener el
# archivo .env fuera del repo y rotar el token si una caja cambia de
# dueno.
POS_AGENT_TOKENS=