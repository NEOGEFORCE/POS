# =============================================================================
# docker/default.conf.template — server block del pos-frontend
# =============================================================================
# El entrypoint oficial de nginx:alpine corre `envsubst` sobre este archivo y
# lo deposita en /etc/nginx/conf.d/default.conf.
#
# Variables inyectadas (ver Dockerfile ENV):
#   ${BACKEND_UPSTREAM}  URL completa del backend, p.ej. http://backend:3000
#
# envsubst NO soporta ${VAR:-default}; el default se fija en el Dockerfile
# vía `ENV BACKEND_UPSTREAM=http://backend:3000`. Al poner el valor ya
# resuelto en la línea `proxy_pass`, nginx lo trata como literal → una sola
# resolución DNS al cargar, sin necesidad de `resolver` dinámico.
# =============================================================================

# Mapeo para header `Connection` en SSE/WebSocket: vacío si el cliente no
# manda Upgrade; "upgrade" si sí. SSE no manda Upgrade — queda vacío, como
# requiere el RFC para no romper keepalive del stream.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' '';
}

server {
    listen       80;
    server_name  _;

    # Raíz del export estático de Next.
    root   /usr/share/nginx/html;
    index  index.html;

    # Headers de seguridad razonables. Nada de CSP estricta: el POS se
    # conecta por WS al bridge local (ws://localhost:9876), carga QRs como
    # blob/data y abre Telegram en nueva pestaña — una CSP mal calibrada
    # rompería todo eso.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;

    # ---------- Health ----------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---------- Service worker y manifest ----------
    # El SW es un kill-switch (ver public/sw.js). Debe revalidarse siempre.
    location = /sw.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri =404;
    }

    location = /manifest.json {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        try_files $uri =404;
    }

    # ---------- Assets inmutables de Next ----------
    # Next genera nombres con hash dentro de /_next/static → cache larga.
    location ^~ /_next/static/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Imágenes/fuentes/logos del public/ — cache moderada.
    location ~* \.(?:png|jpg|jpeg|gif|svg|ico|webp|avif|woff|woff2|ttf|otf|eot)$ {
        access_log off;
        add_header Cache-Control "public, max-age=2592000" always;
        try_files $uri =404;
    }

    # ---------- Proxy al backend ----------
    # `proxy_pass ${BACKEND_UPSTREAM};` SIN trailing slash: nginx conserva
    # el URI del request intacto, así `/api/foo` llega como `/api/foo` al
    # backend (que expone /api/* nativo). envsubst reemplaza con la URL
    # completa en build-time del contenedor; nginx la resuelve una sola vez.
    location /api/ {
        proxy_pass          ${BACKEND_UPSTREAM};
        proxy_http_version  1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # Soporte para SSE y upgrade a WS. SSE en el POS corre sobre fetch
        # + ReadableStream (ver src/components/shared/ModalPagoBoldQR.tsx,
        # src/hooks/useBoldQrGlobalTray.ts, src/app/(app)/sales/new/hooks/
        # useBoldQrTray.ts, GlobalSyncProvider). No necesita Upgrade pero
        # tampoco debemos buffear.
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Upgrade           $http_upgrade;

        # Streaming (SSE): desactivamos buffering/cache y subimos read_timeout
        # a 1h para que la conexión persista entre eventos sin reconexiones.
        proxy_buffering     off;
        proxy_cache         off;
        proxy_read_timeout  1h;
        proxy_send_timeout  1h;
        proxy_connect_timeout 60s;

        # Body grande para OCR de facturas (backend corta a 14 MB).
        client_max_body_size 25m;
    }

    # ---------- Páginas de la app (export estático) ----------
    # El export de Next produce foo.html para cada ruta /foo y preserva
    # subdirectorios (ej. sales/new.html, inventory/history.html). Con
    # `try_files $uri $uri.html $uri/ /index.html` cubrimos:
    #   - assets directos                              → $uri
    #   - rutas limpias tipo /sales/new → sales/new.html → $uri.html
    #   - rutas con slash final /sales/ → sales/index.html → $uri/
    #   - fallback a /index.html (shell PWA)           → /index.html
    location / {
        # No cachear el shell HTML (lo revalidamos siempre; los chunks
        # con hash cuelgan de /_next/static y SÍ cachean).
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        try_files $uri $uri.html $uri/ /index.html;
    }

    # Página de error personalizada: usamos la 404.html del propio export.
    error_page 404 /404.html;
    location = /404.html {
        internal;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    }
}
