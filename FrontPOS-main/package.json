{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002 -H 0.0.0.0",
    "dev:mobile": "next dev --turbopack -p 9002 -H 0.0.0.0",
    "dev:plus": "next dev --turbopack -p 9002 -H 0.0.0.0 --experimental-https",
    "tunnel": "npx localtunnel --port 9002",
    "build": "npm run verify && next build",
    "verify": "npm test && npm run typecheck && npm run lint",
    "postbuild": "if exist out (powershell -Command \"Remove-Item -Recurse -Force ../backPOS-go/out -ErrorAction SilentlyContinue; Copy-Item -Recurse out ../backPOS-go/out\")",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
